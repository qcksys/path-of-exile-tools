# @defaultRequired=true
# @defaultSensitive=false
# ---
POE_CLIENT_ID=
# @sensitive
POE_CLIENT_SECRET=
POE_USER_AGENT_CONTACT=
POE_CLIENT_VERSION=0.0.0
# @type=enum(pc, poe2, xbox, sony)
POE_REALM=pc
PS_LOCAL_DB=/data/market.duckdb
PS_MEMORY_LIMIT=1GB
# Include Standard collector artwork when reading another league on PC.
PS_COLLECT_STANDARD=false
# @type=number(min=1, integer=true)
PS_THREADS=2
# Threads that classify equipment of pages read from a capture process's archive; 0 classifies on
# the main thread. Each needs a core beside PS_THREADS and the main thread.
# @required=false
# @type=number(min=0, integer=true)
PS_CLASSIFY_THREADS=
# Pages applied in one transaction, listings in memory and written together; a batch also ends at
# each hour. A failure replays the whole batch. 1 when empty.
# @required=false
# @type=number(min=1, integer=true)
PS_BATCH_PAGES=
# WAL size at which DuckDB checkpoints; when set, pages are not checkpointed individually.
# @required=false
PS_CHECKPOINT_THRESHOLD=
# Archived equipment pages reclassified per hour; every cycle reclassifies when empty.
# @required=false
# @type=number(min=1, integer=true)
PS_RECLASSIFY_PAGES_PER_HOUR=
# Minutes before a delivered stash hour's later changes are sent again; every cycle when empty.
# @required=false
# @type=number(min=1, integer=true)
PS_REDELIVER_MINUTES=
# Directory for daily Parquet archives of old rows; archiving is off when empty.
# @required=false
PS_ARCHIVE_DIR=
# @type=number(min=3, integer=true)
PS_ARCHIVE_KEEP_DAYS=30
# @type=number(min=1)
PS_ARCHIVE_MAX_GB=100
# With a separate capture process, archive whole hours this far behind the stream position instead.
# @required=false
# @type=number(min=25, integer=true)
PS_ARCHIVE_KEEP_HOURS=
# Directory for hourly zstd archives of every fetched page; raw archiving is off when empty.
# @required=false
PS_RAW_ARCHIVE_DIR=
# Above 1, finished hours are sealed by the zstd command on this many threads.
# @required=false
# @type=number(min=1, integer=true)
PS_RAW_SEAL_THREADS=
# true: a separate `capture` process fetches pages and this worker reads them from the raw archive.
# @required=false
PS_SEPARATE_CAPTURE=
# With PS_SEPARATE_CAPTURE, the UTC hour (YYYY-MM-DDTHH) a new database starts reading the archive.
# @required=false
PS_RAW_FROM=
# Backblaze B2 copy of sealed raw hours; upload is off when B2_KEY_ID is empty.
# @required=false @sensitive
B2_KEY_ID=
# @required=false @sensitive
B2_APPLICATION_KEY=
# Bucket name; the key needs listBuckets and writeFiles on it.
# @required=false
B2_BUCKET=
# Prepended to each uploaded file name, e.g. psapi/pc/
# @required=false
B2_PREFIX=
# The capture lease Worker (apps/capture-lease): `capture` fetches only while it holds the lease,
# and a fallback Container captures while home is silent. Off when empty.
# @required=false
# @type=url
CAPTURE_LEASE_URL=
# @required=false @sensitive
CAPTURE_LEASE_TOKEN=
# home (the default) captures and imports the fallback's pages; fallback is the Container.
# @required=false
# @type=enum(home, fallback)
CAPTURE_LEASE_ROLE=
# @type=url
POE_BOATS_INGEST_URL=
# @sensitive
POE_BOATS_INGEST_TOKEN=
