# GGG Developer API OAuth client credentials.
POE_CLIENT_ID=
POE_CLIENT_SECRET=
POE_USER_AGENT_CONTACT=you@example.com
POE_CLIENT_VERSION=0.0.0

# Realm: pc | poe2 | xbox | sony. Default pc (omitted from path).
POE_REALM=pc

# Local DuckDB file path. Created on first run.
PS_LOCAL_DB=./data.duckdb

# Local retention (prune subcommand). Whichever cap is hit first wins.
PS_LOCAL_MAX_ROWS=2000000
PS_LOCAL_KEEP_DAYS=30

# poe.boats hourly-summary push target. The server requires bearer auth.
POE_BOATS_INGEST_URL=https://poe.boats/api/ingest
POE_BOATS_INGEST_TOKEN=
