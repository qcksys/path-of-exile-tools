# @currentEnv=$APP_ENV
# @defaultRequired=true
# @defaultSensitive=false
# @plugin(@varlock/1password-plugin)
# @cache=if(forEnv(local, dev), "disk", "auto")
# @initOp(token=$OP_SERVICE_ACCOUNT_TOKEN, allowAppAuth=true, cacheTtl=if(forEnv(local, dev), "12h", false))
# ---

# @type=enum(local, test, dev, prod) @internal
APP_ENV=local

# @type=opServiceAccountToken @sensitive @internal @required=false
OP_SERVICE_ACCOUNT_TOKEN=

# @internal
OP_ITEM=op://cgq6s2pwrz5g3jcj6zoreqvjni/w7ykovvpq4qlhmnqleicnjtmxa

POE_CLIENT_ID=op("${OP_ITEM}/POE_CLIENT_ID")

# @sensitive
POE_CLIENT_SECRET=op("${OP_ITEM}/POE_CLIENT_SECRET")

POE_USER_AGENT_CONTACT=op("${OP_ITEM}/POE_USER_AGENT_CONTACT")
POE_CLIENT_VERSION=op("${OP_ITEM}/POE_CLIENT_VERSION")

# @type=enum(pc, poe2, xbox, sony)
POE_REALM=op("${OP_ITEM}/POE_REALM")

PS_LOCAL_DB=./data.duckdb
PS_MEMORY_LIMIT=1GB
# @type=number(min=1, integer=true)
PS_THREADS=2
# WAL size at which DuckDB checkpoints; when set, pages are not checkpointed individually.
# @required=false
PS_CHECKPOINT_THRESHOLD=
# Archived equipment pages reclassified per hour; every cycle reclassifies when empty.
# @required=false
# @type=number(min=1, integer=true)
PS_RECLASSIFY_PAGES_PER_HOUR=
# @type=number(min=1, integer=true)
PS_LOCAL_MAX_ROWS=2000000
# @type=number(min=1, integer=true)
PS_LOCAL_KEEP_DAYS=30
# Directory for daily Parquet archives of old rows; archiving is off when empty.
# @required=false
PS_ARCHIVE_DIR=
# @type=number(min=3, integer=true)
PS_ARCHIVE_KEEP_DAYS=30
# @type=number(min=1)
PS_ARCHIVE_MAX_GB=100
# Directory for hourly zstd archives of every fetched page; raw archiving is off when empty.
# @required=false
PS_RAW_ARCHIVE_DIR=
# Backblaze B2 copy of sealed raw hours; upload is off when B2_KEY_ID is empty.
# @required=false @sensitive
B2_KEY_ID=
# @required=false @sensitive
B2_APPLICATION_KEY=
# Bucket name; the key needs listBuckets and writeFiles on it.
# @required=false
B2_BUCKET=
# Prepended to each uploaded file name, e.g. psapi/pc/
# @required=false
B2_PREFIX=

# @type=url
POE_BOATS_INGEST_URL=op("${OP_ITEM}/POE_BOATS_INGEST_URL")
# @sensitive
POE_BOATS_INGEST_TOKEN=op("${OP_ITEM}/POE_BOATS_INGEST_TOKEN")
