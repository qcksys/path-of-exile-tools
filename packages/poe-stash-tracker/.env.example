# GGG developer app credentials (https://www.pathofexile.com/developer)
POE_CLIENT_ID=your-client-id
POE_CLIENT_SECRET=your-client-secret

# User-Agent identity (GGG requires a contact, usually an email)
POE_CLIENT_VERSION=0.0.1
POE_USER_AGENT_CONTACT=you@example.com

# Target league + realm
POE_LEAGUE=Standard
POE_REALM=pc
