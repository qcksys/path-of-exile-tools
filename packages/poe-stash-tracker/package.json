{
    "name": "@poe-tools/stash-tracker",
    "version": "0.0.0",
    "private": true,
    "description": "Boss-drop price/availability tracker — psapi + cxapi ingestor with local SQLite.",
    "type": "module",
    "imports": {
        "#src/*": "./src/*"
    },
    "scripts": {
        "env:check": "varlock load",
        "db:push": "drizzle-kit push",
        "db:studio": "drizzle-kit studio",
        "ingest:cx": "node src/cli.ts ingest-cx",
        "ingest:ps": "node src/cli.ts ingest-ps",
        "leagues": "node src/cli.ts leagues",
        "build:basemap": "node src/cli.ts build-basemap",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@poe-tools/api-client": "workspace:*",
        "@poe-tools/cli": "workspace:*",
        "@varlock/1password-plugin": "catalog:",
        "better-sqlite3": "catalog:",
        "drizzle-orm": "catalog:",
        "varlock": "catalog:"
    },
    "devDependencies": {
        "@types/better-sqlite3": "catalog:",
        "drizzle-kit": "catalog:",
        "typescript": "catalog:"
    }
}
