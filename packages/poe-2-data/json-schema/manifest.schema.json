{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "number",
      "const": 1
    },
    "game": {
      "type": "string",
      "const": "poe2"
    },
    "version": {
      "type": "string",
      "const": "4.5.5-build.4"
    },
    "client_build": {
      "type": "string",
      "const": "4.5.5.4"
    },
    "source_manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "dat_schema_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "extractor_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "zod_schema_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "weight_provenance": {
      "type": "string",
      "const": "client-extracted; PoE 2 values are not Craft of Exile empirical weights"
    },
    "files": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "schema": {
            "type": "string",
            "pattern": "^json-schema\\/[a-z_]+\\.schema\\.json$"
          }
        },
        "required": [
          "sha256",
          "bytes",
          "schema"
        ],
        "additionalProperties": false
      },
      "minProperties": 1
    }
  },
  "required": [
    "format",
    "game",
    "version",
    "client_build",
    "source_manifest_sha256",
    "dat_schema_sha256",
    "extractor_sha256",
    "zod_schema_sha256",
    "weight_provenance",
    "files"
  ],
  "additionalProperties": false,
  "$id": "urn:qcksys:poe2:4.5.5-build.4:manifest.schema.json",
  "$comment": "Generated from Zod. Cross-field refinements (such as min <= max) and dataset reference checks remain in the Zod validators."
}
