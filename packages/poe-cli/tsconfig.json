{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ESNext"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "noEmit": true,
        "strict": true,
        "skipLibCheck": true,
        "noUncheckedIndexedAccess": true,
        "types": ["node"]
    },
    "include": ["src/**/*.ts", "tests/**/*.ts", "vite.config.ts"]
}
