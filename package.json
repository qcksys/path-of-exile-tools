{
    "name": "path-of-exile-tools",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "ready": "biome check && vp run -r build && vp run -r typecheck && vp run -r test && vp run test:scripts",
        "lint": "biome check",
        "format": "biome check --write --unsafe",
        "dev": "vp run poe-boats#dev",
        "agents:sync": "agents sync",
        "agents:check": "agents sync --check",
        "test:scripts": "vp test --run",
        "prepare": "node scripts/prepare-worktree.ts && vp config && vp run agents:sync"
    },
    "devDependencies": {
        "@agents-dev/cli": "catalog:",
        "@biomejs/biome": "catalog:",
        "@changesets/cli": "catalog:",
        "vite-plus": "catalog:"
    },
    "engines": {
        "node": ">=24.12.0"
    },
    "packageManager": "pnpm@10.32.1"
}
