{
    "$schema": "https://biomejs.dev/schemas/2.4.8/schema.json",
    "files": {
        "includes": [
            "**/*",
            "!apps/{poe-leauge-price-diff,poe-idol-planner}",
            "!**/worker-configuration.d.ts"
        ]
    },
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true,
        "defaultBranch": "main"
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 100
    },
    "linter": {
        "enabled": true,
        "rules": {
            "recommended": true,
            "style": {
                "noNonNullAssertion": "off",
                "useConst": "warn",
                "useNamingConvention": {
                    "level": "warn",
                    "options": {
                        "strictCase": false,
                        "conventions": [
                            {
                                "selector": { "kind": "const" },
                                "formats": ["camelCase", "PascalCase", "CONSTANT_CASE"]
                            },
                            {
                                "selector": { "kind": "variable" },
                                "formats": ["camelCase"]
                            },
                            {
                                "selector": { "kind": "function" },
                                "formats": ["camelCase", "PascalCase"]
                            },
                            {
                                "selector": { "kind": "objectLiteralProperty" },
                                "formats": ["camelCase", "CONSTANT_CASE"]
                            },
                            {
                                "selector": { "kind": "typeProperty" },
                                "formats": ["camelCase", "CONSTANT_CASE"]
                            },
                            {
                                "selector": { "kind": "typeParameter" },
                                "match": "[A-Z][A-Za-z]*"
                            }
                        ]
                    }
                },
                "useFilenamingConvention": {
                    "level": "warn",
                    "options": {
                        "filenameCases": ["snake_case"]
                    }
                }
            }
        }
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "double",
            "semicolons": "always"
        }
    },
    "css": {
        "parser": {
            "tailwindDirectives": true
        }
    },
    "overrides": [
        {
            "includes": [
                "**/better-auth.config.ts",
                "**/react-router.config.ts",
                "**/routes/**/*.ts"
            ],
            "linter": {
                "rules": {
                    "style": {
                        "useFilenamingConvention": "off"
                    }
                }
            }
        }
    ]
}
