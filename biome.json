{
	"$schema": "https://biomejs.dev/schemas/2.4.8/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true,
		"defaultBranch": "main"
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "space",
		"indentWidth": 4,
		"lineWidth": 100
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"style": {
				"noNonNullAssertion": "off",
				"useConst": "warn",
				"useNamingConvention": {
					"level": "warn",
					"options": {
						"strictCase": false,
						"conventions": [
							{
								"selector": { "kind": "const" },
								"formats": ["camelCase", "CONSTANT_CASE"]
							},
							{
								"selector": { "kind": "variable" },
								"formats": ["camelCase"]
							},
							{
								"selector": { "kind": "function" },
								"formats": ["camelCase"]
							},
							{
								"selector": { "kind": "objectLiteralProperty" },
								"formats": ["camelCase", "CONSTANT_CASE"]
							},
							{
								"selector": { "kind": "typeProperty" },
								"formats": ["camelCase", "CONSTANT_CASE"]
							},
							{
								"selector": { "kind": "typeParameter" },
								"match": "[A-Z][A-Za-z]*"
							}
						]
					}
				},
				"useFilenamingConvention": {
					"level": "warn",
					"options": {
						"filenameCases": ["snake_case"]
					}
				}
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always"
		}
	},
	"json": {
		"formatter": {
			"indentStyle": "tab"
		}
	}
}
