{
    "compilerOptions": {
        "lib": ["ESNext"],
        "types": [],
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "noEmit": true,
        "strict": true,
        "skipLibCheck": true,
        "noUncheckedIndexedAccess": true
    },
    "include": ["src/**/*", "worker-configuration.d.ts"]
}
