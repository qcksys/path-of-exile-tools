{
    "name": "poe-boats",
    "version": "0.14.1",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "react-router dev",
        "dev:portless": "portless",
        "build": "react-router build",
        "env:check": "varlock load",
        "game-data:recombinator": "tsx scripts/export-recombinator-catalog.ts",
        "test": "vp test run",
        "test:e2e": "vp test run --config vitest.e2e.config.ts",
        "test:watch": "vp test",
        "deploy:dev:cf": "react-router build --mode dev && cross-env APP_ENV=dev varlock-wrangler deploy --env dev",
        "deploy:prod:cf": "react-router build --mode prod && cross-env APP_ENV=prod varlock-wrangler deploy --env prod",
        "db:drizzle": "varlock run -- tsx node_modules/drizzle-kit/bin.cjs",
        "db:generate": "vp run db:drizzle generate",
        "db:migrate": "vp run db:drizzle migrate",
        "types": "vp run types:cf && vp run types:rr && vp run types:tsc",
        "typecheck": "vp run types",
        "types:cf": "varlock-wrangler types --env-interface CloudflareBindings",
        "types:rr": "react-router typegen",
        "types:tsc": "tsc -b",
        "check:locales": "node scripts/check-locales.mjs",
        "precommit": "vp run types"
    },
    "dependencies": {
        "@base-ui/react": "catalog:",
        "@better-auth/drizzle-adapter": "^1.6.9",
        "@fontsource-variable/geist": "catalog:",
        "@planetscale/database": "^1.20.1",
        "@qcksys/drizzle-extensions": "^0.3.0",
        "@qcksys/pino-cloudflare": "^0.1.0",
        "@react-router/cloudflare": "^7.14.2",
        "@tailwindcss/typography": "catalog:",
        "@varlock/1password-plugin": "catalog:",
        "@varlock/cloudflare-integration": "catalog:",
        "@xyflow/react": "catalog:",
        "better-auth": "^1.6.9",
        "class-variance-authority": "catalog:",
        "clsx": "^2.1.1",
        "cmdk": "catalog:",
        "date-fns": "^4.1.0",
        "drizzle-orm": "catalog:",
        "i18next": "catalog:",
        "i18next-resources-to-backend": "catalog:",
        "isbot": "^5.1.39",
        "ky": "catalog:",
        "lucide-react": "^1.9.0",
        "nanoid": "catalog:",
        "next-themes": "catalog:",
        "pino": "catalog:",
        "react": "^19.2.5",
        "react-dom": "^19.2.5",
        "react-i18next": "catalog:",
        "react-router": "^7.14.2",
        "remix-themes": "catalog:",
        "shadcn": "catalog:",
        "simple-icons": "catalog:",
        "sonner": "catalog:",
        "tailwind-merge": "^3.5.0",
        "varlock": "catalog:",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "^1.33.1",
        "@poe-tools/cli": "workspace:*",
        "@react-router/dev": "^7.14.2",
        "@tailwindcss/vite": "^4.2.4",
        "@testcontainers/mysql": "catalog:",
        "@testing-library/jest-dom": "catalog:",
        "@testing-library/react": "catalog:",
        "@types/node": "^24.12.2",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "cross-env": "catalog:",
        "drizzle-kit": "catalog:",
        "jsdom": "catalog:",
        "linkedom": "catalog:",
        "marked": "catalog:",
        "mysql2": "catalog:",
        "portless": "catalog:",
        "tailwindcss": "^4.2.4",
        "tsx": "^4.21.0",
        "tw-animate-css": "^1.4.0",
        "typescript": "catalog:",
        "vite": "catalog:",
        "vite-plus": "catalog:",
        "wrangler": "catalog:"
    }
}
