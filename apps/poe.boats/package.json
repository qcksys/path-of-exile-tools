{
    "name": "poe-boats",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "react-router dev",
        "test": "vitest run",
        "test:watch": "vitest",
        "deploy:dev:cf": "react-router build --mode worker-dev && wrangler deploy -e=worker-dev",
        "deploy:prod:cf": "react-router build --mode worker-prod && wrangler deploy -e=worker-prod",
        "db:drizzle": "tsx node_modules/drizzle-kit/bin.cjs",
        "db:generate": "pnpm db:drizzle generate",
        "db:migrate": "pnpm db:drizzle migrate",
        "types": "pnpm run types:cf && pnpm run types:rr && pnpm run types:tsc",
        "types:cf": "wrangler types --env-interface CloudflareBindings",
        "types:rr": "react-router typegen",
        "types:tsc": "tsc -b",
        "precommit": "pnpm run biome:ci && pnpm run types"
    },
    "dependencies": {
        "@base-ui/react": "catalog:",
        "@better-auth/drizzle-adapter": "^1.6.0",
        "@fontsource-variable/geist": "catalog:",
        "@planetscale/database": "^1.20.1",
        "@qcksys/drizzle-extensions": "^0.2.0",
        "@react-router/cloudflare": "^7.14.0",
        "@tailwindcss/typography": "catalog:",
        "better-auth": "^1.6.0",
        "class-variance-authority": "catalog:",
        "clsx": "^2.1.1",
        "cmdk": "catalog:",
        "date-fns": "^4.1.0",
        "drizzle-orm": "catalog:",
        "isbot": "^5.1.37",
        "ky": "catalog:",
        "lucide-react": "^1.7.0",
        "nanoid": "catalog:",
        "next-themes": "catalog:",
        "pino": "catalog:",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "react-markdown": "catalog:",
        "react-router": "^7.14.0",
        "remix-themes": "catalog:",
        "shadcn": "catalog:",
        "simple-icons": "catalog:",
        "sonner": "catalog:",
        "tailwind-merge": "^3.5.0",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "^1.31.0",
        "@cloudflare/vitest-pool-workers": "^0.14.1",
        "@react-router/dev": "^7.14.0",
        "@tailwindcss/vite": "^4.2.2",
        "@testing-library/jest-dom": "catalog:",
        "@testing-library/react": "catalog:",
        "@types/node": "^24.12.2",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "dotenv": "^17.4.1",
        "drizzle-kit": "catalog:",
        "jsdom": "catalog:",
        "linkedom": "catalog:",
        "tailwindcss": "^4.2.2",
        "tsx": "^4.21.0",
        "tw-animate-css": "^1.4.0",
        "typescript": "catalog:",
        "vite-plus": "catalog:",
        "vite-tsconfig-paths": "^6.1.1",
        "vitest": "npm:@voidzero-dev/vite-plus-test@^0.1.16",
        "wrangler": "catalog:"
    }
}
