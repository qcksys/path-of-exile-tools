{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "poe-dot-boats-local",
    "account_id": "923e3a86a572d6d6d05230ccadbbbe34",
    "compatibility_date": "2026-04-01",
    "compatibility_flags": ["nodejs_compat"],
    "main": "./workers/app.ts",
    "assets": { "binding": "ASSETS" },
    "observability": {
        "enabled": true,
        "logs": {
            "invocation_logs": false
        }
    },
    "placement": {
        "region": "aws:ap-southeast-2"
    },
    "vars": {
        "URL": "poe-boats.localhost",
        "ENVIRONMENT": "local"
    },
    "env": {
        "prod": {
            "name": "poe-dot-boats-prod",
            "observability": {
                "enabled": true,
                "logs": {
                    "invocation_logs": false
                }
            },
            "vars": {
                "URL": "poe.boats",
                "ENVIRONMENT": "prod"
            },
            "routes": [
                {
                    "pattern": "poe.boats",
                    "custom_domain": true
                }
            ],
            "triggers": {
                "crons": ["*/15 * * * *"]
            }
        },
        "dev": {
            "name": "poe-dot-boats-dev",
            "observability": {
                "enabled": true,
                "logs": {
                    "invocation_logs": false
                }
            },
            "vars": {
                "URL": "dev.poe.boats",
                "ENVIRONMENT": "dev"
            },
            "routes": [
                {
                    "pattern": "dev.poe.boats",
                    "custom_domain": true
                }
            ],
            "triggers": {
                "crons": ["*/15 * * * *"]
            }
        }
    }
}
